# Location: project root, beside pom.xml.
# Copy to .env only if you do not already have one. Never commit real credentials.
# Loaded automatically by ./scripts/start-workflow.sh.
# Guide: docs/runbooks/manual-acceptance.md
# This file is sourced by Bash: quote values containing spaces or shell characters.
# REQUIRED: fill in your provider integration URL and Basic Auth credentials.
SHIPPING_PROVIDER_BASE_URL=''
SHIPPING_PROVIDER_USERNAME=''
SHIPPING_PROVIDER_PASSWORD=''

# OPTIONAL: defaults for local operation.
SHIPPING_PROVIDER_SHIPMENTS_PATH='/rest/shipments'
# Optional exact HTTPS hosts for external label redirects; comma-separated, no scheme.
SHIPPING_PROVIDER_LABEL_HOSTS=''
SHIPPING_DATABASE_PATH='./data/workflow.db'
SHIPPING_DEMO_USER_ID='demo-user'
SHIPPING_PROVIDER_RATE_TIMEOUT='90s'
SHIPPING_PROVIDER_CREATE_TIMEOUT='60s'
SHIPPING_PROVIDER_READ_TIMEOUT='30s'
SERVER_PORT='8080'
MANAGEMENT_SERVER_PORT='9091'
# Optional when JDK 17 cannot be detected automatically:
# JAVA_HOME='/path/to/jdk/Contents/Home'
